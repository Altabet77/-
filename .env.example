# ==========================================
# SAMIR — Personal AI Assistant
# إعدادات بيئة مساعد سمير
# ==========================================

# ─── Server ───────────────────────────────
HOST=0.0.0.0
PORT=8000
SECRET_KEY=samir_secret_jwt_key_change_me_in_production

# ─── AI Providers ─────────────────────────
# Default provider: groq | gemini | openai
DEFAULT_AI_PROVIDER=groq

# Groq (Fast & Free — get key at https://console.groq.com/keys)
GROQ_API_KEY=REPLACE_WITH_YOURS
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# Google Gemini (get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=REPLACE_WITH_YOURS
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / Compatible APIs (Qwen, etc.)
OPENAI_API_KEY=REPLACE_WITH_YOURS
OPENAI_BASE_URL=

# Qwen (via Dashscope)
QWEN_API_KEY=REPLACE_WITH_YOURS

# Local Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Voice System ─────────────────────────
# Available Arabic voices (Edge-TTS):
#   ar-EG-ShakirNeural   — شاكر (مصري، طبيعي)
#   ar-SA-HamedNeural    — حامد (سعودي، هادئ)
#   ar-AE-HamdanNeural   — حمدان (إماراتي، شبابي)
#   ar-EG-SalmaNeural    — سلمى (مصري، أنثوي)
DEFAULT_TTS_VOICE=ar-EG-ShakirNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# ─── Storage ──────────────────────────────
DB_PATH=./data/samir.db

# ─── Security ─────────────────────────────
# HIGH risk tools will wait for user confirmation before executing.
# Set to false to disable confirmations (not recommended).
REQUIRE_HIGH_RISK_CONFIRMATION=true
